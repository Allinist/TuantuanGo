.page { padding: 24rpx; }
.form, .order { padding: 24rpx; margin-bottom: 16rpx; }
.label { color: #8d716a; font-size: 22rpx; margin-bottom: 8rpx; margin-top: 8rpx; }
.input { background: #fff0ed; border-radius: 12rpx; padding: 14rpx; font-size: 24rpx; }
.toggle {
  margin-top: 14rpx; display: flex; justify-content: space-between; background: #ffe9e5;
  border-radius: 12rpx; padding: 14rpx; font-size: 24rpx; color: #59413c;
}
.empty { padding: 24rpx; color: #8d716a; }
.line { display: flex; justify-content: space-between; font-size: 24rpx; margin-bottom: 8rpx; color: #59413c; }
.ship {
  margin-top: 10rpx; text-align: center; background: #ff6b4a; color: #fff;
  border-radius: 14rpx; padding: 16rpx; font-size: 24rpx; font-weight: 600;
}
