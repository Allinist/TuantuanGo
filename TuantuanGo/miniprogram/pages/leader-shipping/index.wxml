<view class="page">
  <view class="section-title">待发货订单</view>
  <view class="card form">
    <view class="label">物流公司</view>
    <input class="input" value="{{logisticsCompany}}" bindinput="onCompanyInput" />
    <view class="label">物流单号</view>
    <input class="input" value="{{trackingNo}}" placeholder="如 SF1234567890" bindinput="onTrackingInput" />
    <view class="toggle" bindtap="toggleNoLogistics">
      <text>无需物流</text>
      <text>{{noLogistics ? '已开启' : '未开启'}}</text>
    </view>
    <view wx:if="{{noLogistics}}">
      <view class="label">无需物流原因</view>
      <input class="input" value="{{noLogisticsReason}}" bindinput="onReasonInput" />
    </view>
  </view>

  <view wx:if="{{!confirmedOrders.length}}" class="card empty">暂无待发货订单。</view>
  <block wx:for="{{confirmedOrders}}" wx:key="id">
    <view class="card order">
      <view class="line"><text>订单号</text><text>{{item.orderNo}}</text></view>
      <view class="line"><text>团</text><text>{{item.groupTitle}}</text></view>
      <view class="line"><text>金额</text><text>¥{{item.amount.totalAmount}}</text></view>
      <view class="ship" data-order-id="{{item.id}}" bindtap="ship">确认发货</view>
    </view>
  </block>
</view>
