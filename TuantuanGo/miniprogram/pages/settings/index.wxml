<view class="safe-bottom page">
  <view class="card profile">
    <view class="avatar">团</view>
    <view>
      <view class="name">团团购用户</view>
      <view class="sub">{{roleText}} · {{userId}}</view>
    </view>
  </view>

  <view class="switch-role" bindtap="toggleRole">切换买家 / 团长卖家</view>
  <view class="switch-role admin-btn" bindtap="switchAdminDemo">切换管理员（演示）</view>

  <view class="card panel">
    <view wx:if="{{isLeader}}" class="row" bindtap="goInventory"><text>库存管理</text><text>></text></view>
    <view class="row" bindtap="goAddressManage"><text>地址管理</text><text>></text></view>
    <view wx:if="{{!isLeader && !isAdmin}}" class="row" bindtap="goLeaderApply"><text>申请团长/卖家</text><text>></text></view>
    <view wx:if="{{isAdmin}}" class="row" bindtap="goAdmin"><text>管理员审核与封禁</text><text>></text></view>
    <view class="row"><text>通知设置</text><text>></text></view>
    <view class="row"><text>帮助与反馈</text><text>></text></view>
  </view>
</view>
<bottom-nav active="settings" />
