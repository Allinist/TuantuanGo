.page {
  padding: 24rpx;
  background: #fffaf8;
}

.search {
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 18rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #3d2d29;
}

.search-btn {
  font-size: 22rpx;
  color: #ffffff;
  background: #ff6b4a;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
}

.clear {
  font-size: 24rpx;
  color: #ae3115;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.filter-title {
  width: 110rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: #8d716a;
}

.filters-scroll {
  flex: 1;
  white-space: nowrap;
}

.filters {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 8rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #ffe9e5;
  color: #8d716a;
}

.chip.on {
  background: #ff6b4a;
  color: #fff;
}

.section-title {
  margin: 12rpx 0 16rpx;
}

.leader-switch {
  display: flex;
  width: 100%;
  background: #fff1ec;
  border-radius: 16rpx;
  padding: 5rpx;
  margin-bottom: 16rpx;
}

.switch-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  color: #8d716a;
  border-radius: 12rpx;
}

.switch-item.on {
  background: #ff6b4a;
  color: #ffffff;
}

.group {
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #f6ddd8;
  flex-shrink: 0;
}

.content {
  flex: 1;
  min-width: 0;
}

.topline {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  flex: 1;
}

.edit-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1;
  color: #ae3115;
  background: #fff1ec;
  border-radius: 999rpx;
  padding: 10rpx 16rpx;
}

.meta {
  color: #8d716a;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.price {
  color: #ae3115;
  font-size: 34rpx;
  font-weight: 700;
}

.stock {
  color: #59413c;
  font-size: 24rpx;
}

.state {
  background: #e9fbf6;
  color: #00705d;
  margin-left: auto;
}

.empty {
  text-align: center;
  color: #8d716a;
  padding: 30rpx 16rpx;
}
