.page { padding: 24rpx; }
.form { padding: 24rpx; }
.label { font-size: 24rpx; color: #8d716a; margin-top: 20rpx; margin-bottom: 10rpx; }
.input, .upload {
  background: #fff0ed; border-radius: 16rpx; padding: 20rpx; color: #59413c;
}
.input-field {
  background: #fff0ed;
  border-radius: 16rpx;
  padding: 20rpx;
  color: #59413c;
  font-size: 26rpx;
}
.cover-preview {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  margin-top: 10rpx;
}
.images-row { margin-top: 10rpx; white-space: nowrap; }
.images-inner { display: inline-flex; gap: 12rpx; }
.thumb-wrap { position: relative; width: 160rpx; height: 160rpx; }
.product-preview { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.thumb-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #261815;
  color: #fff;
  text-align: center;
  line-height: 34rpx;
  font-size: 22rpx;
}
.section { margin-top: 24rpx; font-size: 28rpx; font-weight: 700; color: #261815; }
.options { display: flex; gap: 12rpx; }
.opt {
  padding: 12rpx 20rpx; background: #ffe9e5; border-radius: 999rpx; color: #8d716a; font-size: 24rpx;
}
.opt.on { background: #ff6b4a; color: #fff; }
.batch-btn {
  margin-top: 10rpx; background: #261815; color: #fff; text-align: center;
  border-radius: 14rpx; padding: 14rpx; font-size: 24rpx;
}
.batch-btn.light {
  background: #fff0ed;
  color: #8d716a;
}
.pool-actions { display: grid; gap: 10rpx; margin-top: 8rpx; }
.policy-note { margin-top: 8rpx; color: #8d716a; font-size: 22rpx; }
.bundle-block {
  margin-top: 12rpx;
  background: #fff8f5;
  border: 1rpx solid #f3d7cf;
  border-radius: 12rpx;
  padding: 12rpx;
}
.bundle-title { font-size: 24rpx; color: #59413c; font-weight: 700; margin-bottom: 8rpx; }
.bundle-action-row { display: flex; gap: 10rpx; }
.inline-btn { flex: 1; margin-top: 0; }
.inline-full { margin-top: 10rpx; }
.rule-item { margin-top: 10rpx; background: #fff8f5; border-radius: 12rpx; padding: 10rpx; }
.rule-row { display: flex; justify-content: space-between; align-items: center; font-size: 24rpx; color: #59413c; margin-bottom: 8rpx; }
.toggle-mini { color: #ae3115; font-size: 22rpx; }
.product-row {
  margin-top: 10rpx; display: flex; align-items: center; justify-content: space-between;
  background: #fff0ed; border-radius: 14rpx; padding: 14rpx;
}
.product-name { font-size: 24rpx; color: #59413c; }
.single-date { font-size: 24rpx; color: #ae3115; }
.product-edit {
  margin-top: 14rpx;
  background: #fff8f5;
  border: 1rpx solid #f3d7cf;
  border-radius: 14rpx;
  padding: 14rpx;
}
.role-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #ffe9e5;
  color: #ae3115;
  font-size: 20rpx;
}
.line-two {
  display: flex;
  gap: 12rpx;
}
.half { flex: 1; }
.presale-picker { margin-top: 10rpx; display: block; }
.presale-input {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.rule-section { margin-top: 12rpx; }
.rule-title { font-size: 22rpx; color: #8d716a; margin-bottom: 8rpx; }
.remove-product {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #ae3115;
}
.upload-image { margin-top: 12rpx; }
.submit {
  margin-top: 24rpx; background: #ff6b4a; color: #fff; text-align: center;
  border-radius: 20rpx; padding: 24rpx; font-size: 30rpx; font-weight: 700;
}
