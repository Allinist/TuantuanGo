.page { padding: 24rpx; }
.form { padding: 24rpx; }
.label { font-size: 24rpx; color: #8d716a; margin-top: 20rpx; margin-bottom: 10rpx; }
.input, .upload {
  background: #fff0ed; border-radius: 16rpx; padding: 20rpx; color: #59413c;
}
.input-field {
  background: #fff0ed;
  border-radius: 16rpx;
  padding: 20rpx;
  color: #59413c;
  font-size: 26rpx;
}
.cover-preview {
  width: 100%;
  height: 220rpx;
  border-radius: 16rpx;
  margin-top: 10rpx;
}
.images-row { margin-top: 10rpx; white-space: nowrap; }
.images-inner { display: inline-flex; gap: 12rpx; }
.thumb-wrap { position: relative; width: 160rpx; height: 160rpx; }
.product-preview { width: 160rpx; height: 160rpx; border-radius: 12rpx; }
.thumb-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #261815;
  color: #fff;
  text-align: center;
  line-height: 34rpx;
  font-size: 22rpx;
}
.section { margin-top: 24rpx; font-size: 28rpx; font-weight: 700; color: #261815; }
.options { display: flex; gap: 12rpx; }
.opt {
  padding: 12rpx 20rpx; background: #ffe9e5; border-radius: 999rpx; color: #8d716a; font-size: 24rpx;
}
.opt.on { background: #ff6b4a; color: #fff; }
.batch-btn {
  margin-top: 10rpx; background: #261815; color: #fff; text-align: center;
  border-radius: 14rpx; padding: 14rpx; font-size: 24rpx;
}
.product-row {
  margin-top: 10rpx; display: flex; align-items: center; justify-content: space-between;
  background: #fff0ed; border-radius: 14rpx; padding: 14rpx;
}
.product-name { font-size: 24rpx; color: #59413c; }
.single-date { font-size: 24rpx; color: #ae3115; }
.product-edit {
  margin-top: 14rpx;
  background: #fff8f5;
  border: 1rpx solid #f3d7cf;
  border-radius: 14rpx;
  padding: 14rpx;
}
.line-two {
  display: flex;
  gap: 12rpx;
}
.half { flex: 1; }
.remove-product {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #ae3115;
}
.submit {
  margin-top: 24rpx; background: #ff6b4a; color: #fff; text-align: center;
  border-radius: 20rpx; padding: 24rpx; font-size: 30rpx; font-weight: 700;
}
