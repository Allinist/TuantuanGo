.page { padding: 24rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 14rpx; }
.tab { flex: 1; text-align: center; border-radius: 14rpx; padding: 14rpx 0; background: #fff0ed; color: #8d716a; }
.tab.on { background: #ff6b4a; color: #fff; font-weight: 600; }
.panel { padding: 16rpx 24rpx; }
.item { border-bottom: 1rpx solid #f1ddd8; padding: 16rpx 0; }
.item:last-child { border-bottom: none; }
.line { font-size: 26rpx; color: #2f2523; }
.sub { font-size: 22rpx; color: #8d716a; margin-top: 6rpx; }
.ops { display: flex; gap: 12rpx; margin-top: 8rpx; }
.op { display: inline-block; padding: 8rpx 16rpx; border-radius: 12rpx; font-size: 22rpx; }
.pass { background: #e7f8f1; color: #0f7c5d; }
.reject { background: #fdeceb; color: #b3342c; }
.state { margin-top: 8rpx; color: #8d716a; font-size: 22rpx; }
