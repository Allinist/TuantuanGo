<view class="safe-bottom page">
  <view class="card head">
    <image wx:if="{{group.coverImage}}" class="group-cover" src="{{group.coverImage}}" mode="aspectFill"></image>
    <view class="title">{{group.title}}</view>
    <view class="desc">分类：{{group.category}} · 团长：{{group.leaderName}}</view>
  </view>

  <view class="card block">
    <view class="k">详情</view>
    <view class="v">规则：{{group.saleRuleType}}，发车条件：{{group.departureCondition || '待配置'}}</view>
  </view>

  <view class="card block">
    <view class="k">商品选择</view>
    <block wx:for="{{products}}" wx:key="id">
      <view class="product-item">
        <image class="cover" src="{{item.coverImage}}" mode="aspectFill"></image>
        <view class="content">
          <view class="name">{{item.name}}</view>
          <view class="meta">¥{{item.price}} {{item.presaleDate ? ('预售 ' + item.presaleDate) : '现货'}}</view>
        </view>
        <qty-stepper productId="{{item.id}}" value="{{item.quantity}}" bind:change="onQtyChange" />
      </view>
    </block>
  </view>

  <view class="actions">
    <button class="ghost share-btn" open-type="share">分享拼团</button>
    <view class="solid" bindtap="goCart">查看购物车</view>
  </view>
</view>
