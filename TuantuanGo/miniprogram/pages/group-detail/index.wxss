.page { padding: 24rpx; }
.head, .block { padding: 24rpx; margin-bottom: 16rpx; }
.title { font-size: 34rpx; font-weight: 700; margin-bottom: 10rpx; }
.desc { color: #8d716a; font-size: 24rpx; margin-bottom: 12rpx; }
.line { display: flex; gap: 10rpx; }
.chip { background: #ffe9e5; color: #8d716a; }
.state { background: #e9fbf6; color: #00705d; }
.k { margin-top: 8rpx; color: #8d716a; font-size: 24rpx; }
.v { margin-top: 6rpx; font-size: 26rpx; color: #261815; }
.qr { margin-top: 12rpx; background: #fff0ed; border-radius: 16rpx; text-align: center; padding: 48rpx; color: #8d716a; }
.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.ghost, .solid { flex: 1; text-align: center; padding: 22rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; }
.ghost { border: 1rpx solid #e1bfb8; color: #59413c; background: #fff; }
.solid { background: #ff6b4a; color: #fff; }
