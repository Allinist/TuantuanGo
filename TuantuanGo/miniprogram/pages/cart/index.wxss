.page { padding: 24rpx; }
.item, .fee { padding: 24rpx; margin-bottom: 16rpx; }
.empty { padding: 28rpx; color: #8d716a; margin-bottom: 16rpx; }
.name { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.rule { color: #8d716a; font-size: 22rpx; margin-bottom: 12rpx; }
.row { display: flex; justify-content: space-between; margin-bottom: 8rpx; color: #59413c; }
.qty { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.op {
  width: 44rpx; height: 44rpx; border-radius: 12rpx; text-align: center; line-height: 44rpx;
  background: #ffe9e5; color: #ae3115; font-weight: 700;
}
.total { color: #ae3115; font-weight: 700; margin-top: 8rpx; }
.submit {
  margin-top: 24rpx; background: #ff6b4a; color: #fff; text-align: center;
  padding: 24rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 700;
}
