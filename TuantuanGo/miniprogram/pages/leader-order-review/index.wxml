<view class="page">
  <view class="section-title">待审核订单</view>
  <view class="card remark-box">
    <view class="label">审核备注（本次操作）</view>
    <textarea class="remark" placeholder="通过可留空；驳回建议填写原因" bindinput="onRemarkInput" value="{{reviewRemark}}" />
  </view>

  <view wx:if="{{!pendingOrders.length}}" class="card empty">暂无待审核订单。</view>

  <block wx:for="{{pendingOrders}}" wx:key="id">
    <view class="card order">
      <view class="top">
        <text class="title">{{item.groupTitle}}</text>
        <text class="status">待审核</text>
      </view>
      <view class="line"><text>订单号</text><text>{{item.orderNo}}</text></view>
      <view class="line"><text>买家</text><text>{{item.transferRecord.fromUser}}</text></view>
      <view class="line"><text>应付金额</text><text>¥{{item.amount.totalAmount}}</text></view>
      <view class="ops">
        <view class="btn ghost" data-order-id="{{item.id}}" bindtap="openOrder">查看详情</view>
        <view class="btn reject" data-order-id="{{item.id}}" bindtap="reject">驳回</view>
        <view class="btn approve" data-order-id="{{item.id}}" bindtap="approve">通过</view>
      </view>
    </view>
  </block>
</view>
