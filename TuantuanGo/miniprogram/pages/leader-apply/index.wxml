<view class="page">
  <view class="card box">
    <view class="title">申请团长/卖家</view>
    <view class="desc">仅管理员审核通过后可切换为团长/卖家身份。</view>
    <input class="input" placeholder="姓名" value="{{name}}" bindinput="onInputName" />
    <input class="input" placeholder="电话号码" value="{{phone}}" bindinput="onInputPhone" />
    <textarea class="area" placeholder="申请说明" value="{{reason}}" bindinput="onInputReason"></textarea>
    <view class="btn" bindtap="submitApply">提交申请</view>
  </view>
  <view wx:if="{{latest}}" class="card box">
    <view class="desc">最近申请状态：{{latest.status}}</view>
  </view>
</view>
