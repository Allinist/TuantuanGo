.page { padding: 24rpx; }
.leader-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.leader-tab {
  text-align: center;
  font-size: 22rpx;
  color: #8d716a;
  background: #fff0ed;
  border-radius: 12rpx;
  padding: 12rpx 4rpx;
}
.leader-tab.on {
  color: #fff;
  background: #ff6b4a;
}
.buyer-tabs {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.buyer-tab {
  text-align: center;
  font-size: 21rpx;
  color: #8d716a;
  background: #fff0ed;
  border-radius: 12rpx;
  padding: 12rpx 4rpx;
}
.buyer-tab.on {
  color: #fff;
  background: #ff6b4a;
}
.ship-form { padding: 24rpx; margin-bottom: 16rpx; }
.input { background: #fff0ed; border-radius: 12rpx; padding: 14rpx; font-size: 24rpx; margin-bottom: 10rpx; }
.entry-box {
  background: #fff8f5;
  border: 1rpx solid #f4d9d1;
  border-radius: 12rpx;
  padding: 12rpx;
  margin-bottom: 10rpx;
}
.remove-entry {
  margin-top: 4rpx;
  text-align: right;
  font-size: 22rpx;
  color: #ae3115;
}
.toggle {
  display: flex; justify-content: space-between; background: #ffe9e5; border-radius: 12rpx;
  padding: 14rpx; font-size: 24rpx; color: #59413c; margin: 8rpx 0;
}
.batch-btn {
  margin-top: 10rpx; text-align: center; background: #261815; color: #fff;
  border-radius: 12rpx; padding: 14rpx; font-size: 24rpx;
}
.batch-btn.light {
  margin-top: 0;
  margin-bottom: 8rpx;
  background: #fff0ed;
  color: #8d716a;
}
.order { padding: 24rpx; }
.top { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.merchant { font-size: 26rpx; font-weight: 600; }
.status { color: #00705d; font-size: 22rpx; }
.name { font-size: 28rpx; margin-bottom: 10rpx; }
.pick { margin-bottom: 10rpx; color: #ae3115; font-size: 22rpx; }
.meta { color: #8d716a; font-size: 22rpx; margin-bottom: 10rpx; }
.multi-box { margin-bottom: 10rpx; }
.price { color: #ae3115; font-size: 36rpx; font-weight: 700; }
.ship-btn {
  margin-top: 10rpx; background: #ff6b4a; color: #fff; text-align: center;
  border-radius: 14rpx; padding: 14rpx; font-size: 24rpx; font-weight: 600;
}
.leader-actions { display: flex; gap: 10rpx; margin-top: 10rpx; }
.leader-actions .ship-btn { flex: 1; margin-top: 0; }
.ship-btn.dark { background: #261815; }
