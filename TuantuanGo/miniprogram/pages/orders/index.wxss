.page { padding: 24rpx; }
.chips { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.chip { background: #ffe9e5; color: #8d716a; }
.chip.on { background: #ff6b4a; color: #fff; }
.order { padding: 24rpx; }
.top { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.merchant { font-size: 26rpx; font-weight: 600; }
.status { color: #00705d; font-size: 22rpx; }
.name { font-size: 28rpx; margin-bottom: 10rpx; }
.meta { color: #8d716a; font-size: 22rpx; margin-bottom: 10rpx; }
.price { color: #ae3115; font-size: 36rpx; font-weight: 700; }
