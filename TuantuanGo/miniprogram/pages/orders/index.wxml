<view class="safe-bottom page">
  <view class="chips">
    <text class="chip on">全部</text>
    <text class="chip">待审核</text>
    <text class="chip">已确认</text>
    <text class="chip">已发货</text>
  </view>
  <view wx:if="{{!orders.length}}" class="card order">
    <view class="name">暂无订单，先去市场选购。</view>
  </view>
  <block wx:for="{{orders}}" wx:key="id">
    <view class="card order">
      <view class="top">
        <text class="merchant">{{item.leaderName}}</text>
        <text class="status">{{item.statusLabel}}</text>
      </view>
      <view class="name">{{item.groupTitle}}</view>
      <view class="meta">订单号 {{item.orderNo}} · 共 {{item.items.length}} 件</view>
      <view class="price">{{item.amountLabel}}</view>
    </view>
  </block>
</view>
<bottom-nav active="orders" />
