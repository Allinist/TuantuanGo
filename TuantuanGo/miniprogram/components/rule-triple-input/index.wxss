.triple-row { display: flex; gap: 10rpx; }
.cell {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff0ed;
  border-radius: 12rpx;
  padding: 10rpx;
}
.prefix, .suffix { font-size: 22rpx; color: #8d716a; }
.ipt {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #59413c;
}
